{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "frequi-terminal",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/local/*", "/healthz", "/my-private-entry", "/my-private-entry/*"]
  },
  "kv_namespaces": [
    { "binding": "BOTS_KV", "id": "<your-kv-namespace-id>" }
  ]
}
